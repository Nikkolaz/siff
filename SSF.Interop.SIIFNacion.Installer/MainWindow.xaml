<Window x:Class="SSF.Interop.SIIFNacion.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador — API SIIF Nación y Worker"
        Height="640" Width="920"
        MinHeight="480" MinWidth="720">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Use primero Prerrequisitos si el servidor no tiene .NET 9, SDK, Hosting Bundle o IIS. Luego edite el JSON y despliegue Worker / API. Las acciones elevadas piden UAC."/>

        <GroupBox Grid.Row="1" Header="Rutas de publicación (destino de appsettings.json)" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="API (IIS):" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtApiFolder" Margin="0,0,8,4"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Examinar…" Width="100" Click="BrowseApiFolder_Click" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Worker:" VerticalAlignment="Center" Margin="0,4,8,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtWorkerFolder" Margin="0,4,8,0"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Examinar…" Width="100" Click="BrowseWorkerFolder_Click" Margin="0,4,0,0"/>
            </Grid>
        </GroupBox>

        <TabControl Grid.Row="2" x:Name="Tabs">
            <TabItem Header="Prerrequisitos (.NET / IIS)">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Descarga desde los metadatos oficiales de Microsoft (canal 9.0) e instala en silencio lo que marque y falte en esta máquina. El rol IIS es necesario para publicar la API en IIS; el Hosting Bundle instala el módulo ASP.NET Core y los runtimes; el SDK es opcional en producción pero permite `dotnet` build en el servidor."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Actualizar estado" Padding="10,4" Click="PrereqRefresh_Click" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtPrereqProgress" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkPreIis" Content="Instalar rol IIS (Web Server) si falta" IsChecked="True" Margin="0,4"/>
                        <CheckBox x:Name="ChkPreSdk" Content="Instalar .NET SDK 9.x (win-x64) si falta" IsChecked="True" Margin="0,4"/>
                        <CheckBox x:Name="ChkPreHosting" Content="Instalar ASP.NET Core Hosting Bundle si falta (IIS + runtimes)" IsChecked="True" Margin="0,4"/>
                        <Button Content="Descargar (si aplica) e instalar como administrador…" Padding="12,6" Margin="0,12,0,0" HorizontalAlignment="Left" Click="PrereqInstall_Click"/>
                    </StackPanel>
                    <TextBox x:Name="TxtPrereqStatus"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="12"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="API — appsettings.json">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Plantilla (repo)" Click="ReloadApiDefault_Click" Margin="0,0,6,0" Padding="10,4"/>
                        <Button Content="Cargar desde carpeta API" Click="LoadApiFromFolder_Click" Margin="0,0,6,0" Padding="10,4"/>
                        <Button Content="Reformatear JSON" Click="FormatApiJson_Click" Margin="0,0,6,0" Padding="10,4"/>
                    </StackPanel>
                    <TextBox x:Name="TxtApiJson"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="NoWrap"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Worker — appsettings.json">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Plantilla (repo)" Click="ReloadWorkerDefault_Click" Margin="0,0,6,0" Padding="10,4"/>
                        <Button Content="Cargar desde carpeta Worker" Click="LoadWorkerFromFolder_Click" Margin="0,0,6,0" Padding="10,4"/>
                        <Button Content="Reformatear JSON" Click="FormatWorkerJson_Click" Margin="0,0,6,0" Padding="10,4"/>
                    </StackPanel>
                    <TextBox x:Name="TxtWorkerJson"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="NoWrap"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Servicio Windows (Worker)">
                <StackPanel Margin="12">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Detiene y elimina el servicio si ya existe, luego lo crea con `dotnet.exe` y el DLL del Worker en la carpeta indicada arriba. Requiere ASP.NET Core Runtime/Hosting en el servidor."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre del servicio" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtServiceName" Margin="0,0,0,8" Text="SiifInteropWorker"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="dotnet.exe" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDotnetPath" Text=""/>
                    </Grid>
                    <Button Content="Instalar o reinstalar servicio (administrador)…" Margin="0,16,0,0" HorizontalAlignment="Left" Padding="12,6" Click="InstallWorkerService_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="IIS (API)">
                <StackPanel Margin="12">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Crea o reemplaza el sitio web con la carpeta física de la API. Debe estar instalado el Hosting Bundle de .NET y el rol IIS con ASP.NET."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre del sitio" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtIisSite" Margin="0,0,0,8" Text="SiifInteropApi"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="App pool" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtIisPool" Margin="0,0,0,8" Text="SiifInteropApiPool"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Puerto HTTP" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtIisPort" Text="8080"/>
                    </Grid>
                    <Button Content="Crear o actualizar sitio IIS (administrador)…" Margin="0,16,0,0" HorizontalAlignment="Left" Padding="12,6" Click="InstallIis_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Guardar ambos appsettings.json" Padding="14,6" Click="SaveBoth_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
